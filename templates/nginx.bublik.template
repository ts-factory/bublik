# Copy this file to /etc/nginx/sites-available/bublik
# sudo ln -s /etc/nginx/sites-available/bublik /etc/nginx/sites-enabled

server {
    listen 80;
    server_name 0.0.0.0;
    large_client_header_buffers 16 5120k;
    
    location = $URL_PREFIX/favicon.ico { access_log off; log_not_found off; }
    location $URL_PREFIX/static/ {
        alias $BUBLIK_WEB_STATIC/static/;
    }

    location ^~ $URL_PREFIX/api/v2/chat {
        include proxy_params;
        proxy_pass http://$BUBLIK_BIND_GUNICORN;
        proxy_http_version 1.1;
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location $URL_PREFIX/ {
        include proxy_params;
        proxy_pass http://$BUBLIK_BIND_GUNICORN;
        proxy_read_timeout 300;
    }

    # Files here carry a content hash in their names, so they never change.
    # A missing one must be a 404: a tab opened before a UI update asks for
    # files of the previous build, and must not get index.html instead.
    location ^~ $URL_PREFIX/v2/assets/ {
        alias $BUBLIK_UI_DIR/dist/${BUBLIK_UI_APP}/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html and version.json name the current build: always revalidate.
    location $URL_PREFIX/v2/ {
        alias $BUBLIK_UI_DIR/dist/${BUBLIK_UI_APP}/;
        index index.html;
        try_files ${DOLLAR}uri $URL_PREFIX/v2/index.html;
        add_header Cache-Control "no-cache";
    }

    location $URL_PREFIX/flower/ {
        proxy_pass http://$BUBLIK_BIND_FLOWER;
        proxy_set_header Host ${DOLLAR}host;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~ ^$URL_PREFIX/mcp(/|$) {
        rewrite ^$URL_PREFIX/(.*)${DOLLAR} /${DOLLAR}1 break;

        proxy_pass http://$BUBLIK_BIND_MCP;

        # standard headers
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;

        # SSE / long polling support
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_set_header Accept "text/event-stream, application/json";
        proxy_read_timeout 86400s;
    }
}
