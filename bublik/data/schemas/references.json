{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "Project references",
    "properties": {
        "LOGS_BASES": {
            "description": "Logs base URIs",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "uri": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "^(https?|s3)://"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                    },
                    "storage": {
                        "description": "Where the logs of this base are stored when it is not a TE log server. Every field but 'type' is optional and falls back to the matching S3_* Django setting (the bundled SeaweedFS). Credentials are never stored in the config: they are ${env:LOGS_NAME} or ${settings:LOGS_NAME} references.",
                        "type": "object",
                        "properties": {
                            "type": {
                                "const": "s3"
                            },
                            "endpoint_url": {
                                "description": "S3 endpoint Bublik reaches the bucket at.",
                                "type": "string",
                                "pattern": "^https?://"
                            },
                            "public_endpoint_url": {
                                "description": "Browser-reachable S3 endpoint. When set, log pages that already exist are served to the browser as presigned URLs on it.",
                                "type": "string",
                                "pattern": "^https?://"
                            },
                            "region": {
                                "type": "string",
                                "minLength": 1
                            },
                            "access_key": {
                                "description": "Reference to the access key, e.g. ${env:LOGS_S3_ACCESS_KEY}.",
                                "type": "string",
                                "pattern": "^\\$\\{(env|settings):LOGS_[A-Z0-9_]+\\}$"
                            },
                            "secret_key": {
                                "description": "Reference to the secret key, e.g. ${env:LOGS_S3_SECRET_KEY}.",
                                "type": "string",
                                "pattern": "^\\$\\{(env|settings):LOGS_[A-Z0-9_]+\\}$"
                            },
                            "upload": {
                                "description": "Tarballs uploaded to this project are stored under this base. Without such a base, uploads to the project are refused.",
                                "type": "boolean",
                                "default": false
                            }
                        },
                        "required": [
                            "type"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "name",
                    "uri"
                ],
                "additionalProperties": false,
                "description": "A logs base: the URIs runs' logs live under. By default these are http(s) URIs of a TE log server. With an S3 'storage' block they are s3://bucket/prefix/ URIs instead.",
                "if": {
                    "required": [
                        "storage"
                    ]
                },
                "then": {
                    "properties": {
                        "uri": {
                            "items": {
                                "pattern": "^s3://[^/]+/"
                            }
                        }
                    }
                },
                "else": {
                    "properties": {
                        "uri": {
                            "items": {
                                "pattern": "^https?://"
                            }
                        }
                    }
                }
            },
            "minItems": 1,
            "uniqueItems": true,
            "default": [
                {
                    "name": "Test Logs Base",
                    "uri": [
                        "https://ts-factory.io/logs/"
                    ]
                }
            ]
        },
        "ISSUES": {
            "description": "Issue tracker URIs",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "uri": {
                        "type": "string",
                        "pattern": "^https?://"
                    }
                },
                "required": [
                    "name",
                    "uri"
                ],
                "additionalProperties": false
            }
        },
        "REVISIONS": {
            "description": "Revision URIs",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "uri": {
                        "type": "string",
                        "pattern": "^https?://"
                    }
                },
                "required": [
                    "name",
                    "uri"
                ],
                "additionalProperties": false
            },
            "default": {
                "TE_REV": {
                    "name": "Test Environment",
                    "uri": "https://github.com/ts-factory/test-environment"
                }
            }
        }
    },
    "additionalProperties": false
}
